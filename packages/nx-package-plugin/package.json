{
  "name": "@blackanvil/nx-package-plugin",
  "version": "0.2.0",
  "description": "Nx plugin for scaffolding TypeScript packages with tsup",
  "license": "MIT",
  "private": false,
  "author": "Black Anvil",
  "repository": {
    "type": "git",
    "url": "https://github.com/vishrutreddi/foundry.git",
    "directory": "packages/nx-package-plugin"
  },
  "keywords": [
    "nx",
    "nx-plugin",
    "generator",
    "tsup",
    "typescript"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tsup-options.schema.json": "./dist/generators/tsup-package/tsup-options.schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nx/devkit": "22.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "vitest": "*"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "generators.json"
  ],
  "generators": "./generators.json"
}
