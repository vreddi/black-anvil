{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@blackanvil/nx-package-plugin",
  "sourceRoot": "packages/nx-package-plugin/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "tsc --build tsconfig.lib.json",
          "cp -r src/generators/tsup-package/*.json dist/generators/tsup-package/",
          "cp -r src/generators/tsup-package/files dist/generators/tsup-package/"
        ],
        "cwd": "packages/nx-package-plugin",
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/nx-package-plugin"
      }
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "options": {
        "packageRoot": "packages/nx-package-plugin"
      }
    }
  },
  "tags": ["preview", "publishable"]
}
